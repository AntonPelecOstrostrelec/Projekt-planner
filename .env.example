# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron endpoint auth (Vercel sets this automatically for managed crons)
CRON_SECRET=

# Google Calendar OAuth (Phase 2 — optional, enables bi-directional sync)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email (Phase 2 — optional, enables email deadline alerts via Resend)
RESEND_API_KEY=
EMAIL_FROM="Pushnik <noreply@yourdomain.com>"

# Web Push (Phase 2 — optional, enables browser push)
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:you@yourdomain.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# AI coach (Phase 5)
# ANTHROPIC_API_KEY=
